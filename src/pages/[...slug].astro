---
import { getCollection, render } from 'astro:content';
import Layout from "@layouts/Layout.astro";
import { SITE } from "@data/site";
import { formatDate, getNoteNumber, estimateReadingTime, getAdjacentPosts } from "@lib/posts";
import { humanizeTag } from "@lib/seo";
import { publicImageDimensions } from "@lib/image-dimensions";
import Colophon from "@components/Colophon.astro";
import PostNav from "@components/PostNav.astro";
import AuthorSnippet from "@components/AuthorSnippet.astro";
import TagList from "@components/TagList.astro";
import ShareButtons from "@components/ShareButtons.astro";
import TableOfContents from "@components/TableOfContents.astro";
import type { TocItem } from "@components/TableOfContents.astro";

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Detect whether the post body contains any diagram fences so we can
// conditionally inject the Mermaid initialisation script.
const bodySource = post.body ?? "";
const HAS_DIAGRAMS =
  /^```(mermaid|c4)\b/m.test(bodySource) ||
  /^```(text|txt|plain|plaintext)?\r?\n[\s\S]*?^C4(Context|Container|Component|Dynamic|Deployment)\b/m.test(bodySource) ||
  /^```\r?\n[\s\S]*?^(graph|flowchart|sequenceDiagram|classDiagram|stateDiagram|erDiagram)\b/m.test(bodySource);

const noteId = await getNoteNumber(post);
const readingTime = estimateReadingTime(post.body ?? "");
const wordCount = (post.body ?? "")
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;
const { newer, older } = await getAdjacentPosts(post);

const cover = await publicImageDimensions(post.data.cover);
const modifiedTime = (post.data.updated ?? post.data.date).toISOString();

const tocItems: TocItem[] = headings
  .filter(
    (h) =>
      (h.depth === 2 || h.depth === 3) &&
      !/^(sources|references|footnotes)$/i.test(h.text.trim()),
  )
  .map((h) => ({
    id: h.slug,
    text: h.text,
    level: h.depth as 2 | 3,
  }));
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.cover ?? SITE.ogImage}
  ogImageAlt={post.data.coverAlt ?? post.data.title}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={modifiedTime}
  tags={post.data.tags}
  section={post.data.tags?.[0] ? humanizeTag(post.data.tags[0]) : undefined}
  wordCount={wordCount}
  readingMinutes={readingTime}
  imageWidth={cover?.width}
  imageHeight={cover?.height}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="lg:grid lg:grid-cols-[220px_1fr] lg:gap-16">
      <aside class="marginalia-rail hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <a href="/notes/" class="note-meta hover:text-tertiary transition-colors block">&larr; All notes</a>

          <div class="space-y-3">
            <p class="note-id">{noteId}</p>
            <p class="marginalia">{readingTime} min read</p>
            <p class="marginalia">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </p>
          </div>

          {tocItems.length > 0 && <TableOfContents items={tocItems} />}

          {post.data.tags && post.data.tags.length > 0 && (
            <div>
              <p class="note-meta mb-3">// Filed under</p>
              <TagList tags={post.data.tags} />
            </div>
          )}
        </div>
      </aside>

      <article class="min-w-0" data-pagefind-body>
        <header class="mb-10">
          <p class="section-marker lg:hidden">
            <a href="/notes/" class="hover:text-tertiary transition-colors">&larr; All notes</a>
          </p>
          <p class="note-id mb-3 lg:hidden">{noteId}</p>
          <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight mb-4" data-pagefind-meta="title">
            {post.data.title}
          </h1>
          <div class="note-meta flex items-center gap-3 mb-6">
            <time datetime={post.data.date.toISOString()} data-pagefind-meta="date">{formatDate(post.data.date)}</time>
            <span aria-hidden="true">-</span>
            <AuthorSnippet variant="byline" />
          </div>
          <p class="text-on-surface-variant text-lg leading-relaxed border-l-2 border-tertiary/50 pl-4 mb-6">
            {post.data.description}
          </p>
          <div class="lg:hidden">
            <TagList tags={post.data.tags ?? []} />
          </div>
        </header>

        <div class="prose-note drop-cap" data-has-diagrams={HAS_DIAGRAMS ? "true" : undefined}>
          <Content />
        </div>

        <ShareButtons title={post.data.title} />

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-12 pt-8 rule-line lg:hidden">
            <TagList tags={post.data.tags} />
          </div>
        )}

        <AuthorSnippet variant="card" />
        <PostNav newer={newer} older={older} />
        <Colophon />
      </article>
    </div>
  </div>

  <script>
    const PLAIN_LANGS = new Set(["plaintext", "plain", "text", "txt", "ansi"]);
    const DIAGRAM_KEYWORDS = /^(C4(Context|Container|Component|Dynamic|Deployment)|graph|flowchart|sequenceDiagram|classDiagram|stateDiagram(-v2)?|erDiagram|journey|gantt|pie|gitGraph|mindmap|timeline|quadrantChart|sankey-beta|xychart-beta|packet-beta|kanban|architecture-beta)\b/m;

    function isPlainBlock(pre: HTMLPreElement) {
      const lang = (pre.dataset.language || "").toLowerCase();
      return !lang || PLAIN_LANGS.has(lang);
    }

    function isDiagramBlock(pre: HTMLPreElement) {
      if (pre.dataset.diagram) return true;
      const lang = (pre.dataset.language || "").toLowerCase();
      if (lang === "mermaid" || lang === "c4") return true;
      const text = (pre.textContent || "").trim();
      return DIAGRAM_KEYWORDS.test(text);
    }

    function legacyCopy(text: string) {
      const helper = document.createElement("textarea");
      helper.value = text;
      helper.setAttribute("readonly", "");
      helper.style.position = "fixed";
      helper.style.opacity = "0";
      document.body.appendChild(helper);
      helper.select();
      const ok = document.execCommand("copy");
      document.body.removeChild(helper);
      return ok;
    }

    function copyToClipboard(pre: HTMLPreElement): Promise<boolean> {
      const code = (pre.textContent || "").replace(/\n+$/, "");
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(code).then(
          function onOk() {
            return true;
          },
          function onErr() {
            return legacyCopy(code);
          },
        );
      }
      return Promise.resolve(legacyCopy(code));
    }

    function buildHeader(lang: string, pre: HTMLPreElement) {
      const header = document.createElement("div");
      header.className = "code-terminal-header";
      header.setAttribute("data-pagefind-ignore", "");

      const label = document.createElement("span");
      label.className = "code-terminal-lang";
      label.textContent = "Terminal // " + lang;
      header.appendChild(label);

      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-terminal-copy";
      button.setAttribute("aria-label", "Copy code to clipboard");
      button.textContent = "Copy";
      button.addEventListener("click", function onClick() {
        copyToClipboard(pre).then(function onCopied(copied) {
          if (!copied) return;
          button.textContent = "Copied";
          button.classList.add("is-copied");
          window.setTimeout(function reset() {
            button.textContent = "Copy";
            button.classList.remove("is-copied");
          }, 2000);
          document.dispatchEvent(
            new CustomEvent("toast:show", {
              detail: "Snippet copied to clipboard",
            }),
          );
        });
      });
      header.appendChild(button);

      return header;
    }

    function enhance(pre: HTMLPreElement) {
      if (isDiagramBlock(pre)) return; // handled separately
      if (isPlainBlock(pre)) return;
      if (pre.parentElement && pre.parentElement.classList.contains("code-terminal")) return;

      const lang = (pre.dataset.language || "").toLowerCase();
      const wrapper = document.createElement("div");
      wrapper.className = "code-terminal";
      if (pre.parentNode) pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(buildHeader(lang, pre));
      wrapper.appendChild(pre);
    }

    function initCodeTerminals() {
      document.querySelectorAll(".prose-note pre").forEach(function each(pre) {
        enhance(pre as HTMLPreElement);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initCodeTerminals);
    } else {
      initCodeTerminals();
    }
  </script>

  {HAS_DIAGRAMS && (
  <script is:inline>
    // ─── Mermaid diagram rendering ────────────────────────────────────────────
    // Mermaid.js (+ C4 diagrams extension) is loaded lazily on the first
    // "Render Diagram" click.  Subsequent clicks on any diagram reuse the
    // already-loaded module.
    // is:inline keeps this out of Astro's bundle so the conditional works.

    (function () {
      var DIAGRAM_KEYWORDS = /^(C4(Context|Container|Component|Dynamic|Deployment)|graph|flowchart|sequenceDiagram|classDiagram|stateDiagram(-v2)?|erDiagram|journey|gantt|pie|gitGraph|mindmap|timeline|quadrantChart|sankey-beta|xychart-beta|packet-beta|kanban|architecture-beta)\b/m;

      function isDiagram(pre) {
        if (pre.dataset.diagram) return true;
        var lang = (pre.dataset.language || "").toLowerCase();
        if (lang === "mermaid" || lang === "c4") return true;
        var text = (pre.textContent || "").trim();
        return DIAGRAM_KEYWORDS.test(text);
      }

      var mermaidReady = null;

      function loadMermaid() {
        if (mermaidReady) return mermaidReady;
        mermaidReady = new Promise(function (resolve, reject) {
          // Mermaid ESM — includes C4 support natively since v10
          var script = document.createElement("script");
          script.type = "module";
          script.textContent = [
            "import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';",
            "mermaid.initialize({",
            "  startOnLoad: false,",
            "  theme: 'dark',",
            "  themeVariables: {",
            "    background: '#0B132B',",
            "    primaryColor: '#1C2541',",
            "    primaryTextColor: '#E2E8F0',",
            "    primaryBorderColor: '#334155',",
            "    lineColor: '#94A3B8',",
            "    secondaryColor: '#1E293B',",
            "    tertiaryColor: '#0EA5E9',",
            "    edgeLabelBackground: '#1C2541',",
            "    clusterBkg: '#1C2541',",
            "    titleColor: '#F59E0B',",
            "    attributeBackgroundColorEven: '#1C2541',",
            "    attributeBackgroundColorOdd: '#0B132B',",
            "  },",
            "  fontFamily: '\"Fira Code\", \"Space Grotesk\", monospace',",
            "  c4: { diagramMarginY: 30 },",
            "});",
            "window.__mermaid = mermaid;",
            "document.dispatchEvent(new Event('mermaid:ready'));",
          ].join("\n");
          document.head.appendChild(script);

          document.addEventListener("mermaid:ready", function () { resolve(); }, { once: true });
          window.setTimeout(function () {
            reject(new Error("Mermaid load timeout"));
          }, 15000);
        });
        return mermaidReady;
      }

      var diagramSeq = 0;

      function buildDiagramTerminal(pre) {
        var rawCode = (pre.dataset.diagramCode || pre.textContent || "").trim();
        var isC4 = pre.dataset.diagram === "c4" ||
                   pre.dataset.language === "c4" ||
                   /^C4(Context|Container|Component|Dynamic|Deployment)\b/m.test(rawCode);
        var diagramType = isC4 ? "C4" : "MERMAID";

        var wrapper = document.createElement("div");
        wrapper.className = "diagram-terminal";

        // ── header ────────────────────────────────────────────────────────────
        var header = document.createElement("div");
        header.className = "diagram-terminal-header";
        header.setAttribute("data-pagefind-ignore", "");

        var label = document.createElement("span");
        label.className = "diagram-terminal-label";
        label.textContent = "Diagram // " + diagramType;
        header.appendChild(label);

        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "diagram-terminal-btn";
        btn.setAttribute("aria-label", "Render diagram");
        btn.textContent = "Render Diagram";
        header.appendChild(btn);
        wrapper.appendChild(header);

        // ── loading indicator ─────────────────────────────────────────────────
        var loadingEl = document.createElement("div");
        loadingEl.className = "diagram-terminal-loading";
        loadingEl.textContent = "Rendering\u2026";
        wrapper.appendChild(loadingEl);

        // ── output pane ───────────────────────────────────────────────────────
        var output = document.createElement("div");
        output.className = "diagram-terminal-output";
        wrapper.appendChild(output);

        // ── original <pre> stays in the DOM (code view) ───────────────────────
        wrapper.appendChild(pre);

        // ── toggle logic ──────────────────────────────────────────────────────
        var rendered = false;

        btn.addEventListener("click", function onClick() {
          if (rendered) {
            output.classList.remove("is-visible");
            pre.style.display = "";
            btn.textContent = "Render Diagram";
            btn.setAttribute("aria-label", "Render diagram");
            btn.classList.remove("is-rendered");
            rendered = false;
            return;
          }

          pre.style.display = "none";
          loadingEl.classList.add("is-visible");
          btn.disabled = true;
          btn.textContent = "Rendering\u2026";

          loadMermaid().then(function () {
            var id = "diagram-" + (++diagramSeq);
            return window.__mermaid.render(id, rawCode);
          }).then(function (result) {
            output.innerHTML = result.svg;
            output.classList.add("is-visible");
            loadingEl.classList.remove("is-visible");
            btn.textContent = "Show Code";
            btn.setAttribute("aria-label", "Show diagram source code");
            btn.classList.add("is-rendered");
            btn.disabled = false;
            rendered = true;
          }).catch(function (err) {
            loadingEl.classList.remove("is-visible");
            pre.style.display = "";
            btn.textContent = "Render Diagram";
            btn.setAttribute("aria-label", "Render diagram");
            btn.disabled = false;
            document.dispatchEvent(
              new CustomEvent("toast:show", {
                detail: "Diagram rendering failed \u2014 check the console",
              })
            );
            console.error("[diagram-terminal] render error:", err);
          });
        });

        return wrapper;
      }

      function initDiagramTerminals() {
        document.querySelectorAll(".prose-note pre").forEach(function (pre) {
          if (!isDiagram(pre)) return;
          if (pre.parentElement && (pre.parentElement.classList.contains("diagram-terminal") || pre.parentElement.classList.contains("code-terminal"))) return;
          var parent = pre.parentNode;
          var nextSibling = pre.nextSibling;
          var wrapper = buildDiagramTerminal(pre);
          if (parent) {
            parent.insertBefore(wrapper, nextSibling);
          }
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initDiagramTerminals);
      } else {
        initDiagramTerminals();
      }
    })();
  </script>
  )}
</Layout>
