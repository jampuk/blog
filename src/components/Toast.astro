<div
  id="toast"
  data-toast
  role="status"
  aria-live="polite"
  class="fixed bottom-6 left-1/2 z-[110] w-max max-w-[calc(100vw-2rem)] -translate-x-1/2 translate-y-4 opacity-0 invisible pointer-events-none transition-all duration-200 ease-out"
>
  <div class="flex items-center gap-2.5 px-4 py-3 rounded-lg bg-surface-container border border-outline shadow-level-2 text-on-surface">
    <svg class="w-4 h-4 text-success flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span data-toast-message class="truncate font-heading text-sm"></span>
    <button
      type="button"
      data-toast-close
      aria-label="Dismiss notification"
      class="flex-shrink-0 p-1 rounded-md text-on-surface-variant hover:text-on-surface hover:bg-white/10 transition-colors focus:outline-none"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<script>
  {
    const toast = document.querySelector("[data-toast]");
    const messageEl = document.querySelector("[data-toast-message]");
    const closeBtn = document.querySelector("[data-toast-close]");

    if (toast && messageEl && closeBtn) {
      let hideTimer: ReturnType<typeof setTimeout> | undefined;
      let isVisible = false;

      const hideToast = () => {
        if (!isVisible) return;
        clearTimeout(hideTimer);
        isVisible = false;
        toast.classList.add("opacity-0", "translate-y-4", "invisible", "pointer-events-none");
      };

      const showToast = (message: string) => {
        messageEl.textContent = message;
        clearTimeout(hideTimer);
        isVisible = true;
        toast.classList.remove("opacity-0", "translate-y-4", "invisible", "pointer-events-none");
        hideTimer = setTimeout(hideToast, 3000);
      };

      closeBtn.addEventListener("click", hideToast);

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isVisible) hideToast();
      });

      document.addEventListener("toast:show", (event) => {
        showToast((event as CustomEvent<string>).detail);
      });
    }
  }
</script>
