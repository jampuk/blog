---
import { formatDate, estimateReadingTime } from "@lib/posts";

interface Props {
  date: Date;
  readingTime?: number;
  body?: string;
  noteId?: string;
}

const { date, readingTime, body, noteId } = Astro.props;
const minutes = readingTime ?? (body ? estimateReadingTime(body) : 1);
---

<div class="note-meta flex items-center gap-3">
  {noteId && <span class="note-id">{noteId}</span>}
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
  <span aria-hidden="true">-</span>
  <span>{minutes} min read</span>
</div>
