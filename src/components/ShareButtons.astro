---
interface Props {
  title: string;
}

const { title } = Astro.props;
const url = Astro.url.href;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const obsidianContent = encodeURIComponent(`[${title}](${url})`);

const socialTargets = [
  {
    label: "Share on X",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    icon: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
    bg: "#000000",
    fg: "#FFFFFF",
  },
  {
    label: "Share on Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z",
    bg: "#1877F2",
    fg: "#FFFFFF",
  },
  {
    label: "Share on LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
    bg: "#0A66C2",
    fg: "#FFFFFF",
  },
];

const bookmarkTargets = [
  {
    label: "Save to Obsidian",
    href: `obsidian://new?name=${encodedTitle}&content=${obsidianContent}&silent`,
    external: false,
  },
  {
    label: "Save to Raindrop",
    href: `https://app.raindrop.io/add?link=${encodedUrl}&title=${encodedTitle}`,
  },
  {
    label: "Save to Pinboard",
    href: `https://pinboard.in/add?url=${encodedUrl}&title=${encodedTitle}`,
  },
];
---

<div class="mt-12 pt-8 rule-line" data-pagefind-ignore>
  <p class="note-meta mb-4">// Share this note</p>
  <div class="flex flex-wrap items-center gap-3">
    {socialTargets.map((target) => (
      <a
        href={target.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={target.label}
        class="inline-flex items-center justify-center w-9 h-9 rounded-md transition-colors"
        style={`background-color: ${target.bg}`}
      >
        <svg
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill={target.fg}
          aria-hidden="true"
        >
          <path d={target.icon} />
        </svg>
      </a>
    ))}

    <span class="mx-1 h-5 w-px bg-outline" aria-hidden="true"></span>

    {bookmarkTargets.map((target) => (
      <a
        href={target.href}
        target={target.external === false ? undefined : "_blank"}
        rel={target.external === false ? undefined : "noopener noreferrer"}
        class="inline-flex items-center px-4 py-2 rounded-md bg-surface-container hover:bg-surface-high text-on-surface-variant hover:text-tertiary transition-colors text-sm font-heading"
      >
        {target.label}
      </a>
    ))}

    <a
      href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}
      class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-surface-container hover:bg-surface-high text-on-surface-variant hover:text-tertiary transition-colors text-sm font-heading"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
      </svg>
      <span>Email</span>
    </a>
    <button
      type="button"
      aria-label="Copy link"
      data-copy-url={url}
      class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-surface-container hover:bg-surface-high text-on-surface-variant hover:text-tertiary transition-colors text-sm font-heading"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" />
      </svg>
      <span>Copy link</span>
    </button>
  </div>
</div>

<script>
  const copyBtn = document.querySelector("[data-copy-url]");

  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      const url = copyBtn.getAttribute("data-copy-url");
      if (!url) return;

      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = url;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        document.body.removeChild(textarea);
      }

      document.dispatchEvent(
        new CustomEvent("toast:show", {
          detail: `Copied ${url} into clipboard`,
        })
      );
    });
  }
</script>
