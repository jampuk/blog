---
import { SITE } from "@data/site";
import {
  absoluteUrl,
  buildOrganization,
  buildWebsite,
  buildBreadcrumbs,
  breadcrumbsForPath,
  buildAuthor,
  buildArticle,
  OG_IMAGE_WIDTH,
  OG_IMAGE_HEIGHT,
  humanizeTag,
} from "@lib/seo";

interface Props {
  title: string;
  pageTitle?: string;
  description: string;
  canonicalURL: string;
  ogImage: string;
  ogImageAlt?: string;
  pathname: string;
  siteName: string;
  locale?: string;
  twitterSite?: string;
  twitterCreator?: string;
  noindex?: boolean;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  section?: string;
  wordCount?: number;
  readingMinutes?: number;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  pageTitle = title,
  description,
  canonicalURL,
  ogImage,
  ogImageAlt = title,
  pathname,
  siteName,
  locale = SITE.locale,
  twitterSite = SITE.twitter,
  twitterCreator = SITE.twitter,
  noindex = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags,
  section,
  wordCount,
  readingMinutes,
  imageWidth = OG_IMAGE_WIDTH,
  imageHeight = OG_IMAGE_HEIGHT,
} = Astro.props;

const ogImageUrl = absoluteUrl(ogImage, SITE.url);
const ogUrl = canonicalURL || absoluteUrl("/", SITE.url);

const extension = ogImage.split(/[?#]/)[0].split(".").pop()?.toLowerCase();
const ogImageType =
  extension === "png"
    ? "image/png"
    : extension === "webp"
      ? "image/webp"
      : extension === "avif"
        ? "image/avif"
        : extension === "gif"
          ? "image/gif"
          : "image/jpeg";

const jsonLd: Record<string, unknown>[] = [
  buildOrganization(),
  buildWebsite(),
  buildAuthor(),
];

const crumbs = breadcrumbsForPath(pathname, pageTitle);
const breadcrumb = crumbs ? buildBreadcrumbs(crumbs) : null;
if (breadcrumb) jsonLd.push(breadcrumb);

if (ogType === "article") {
  jsonLd.push(
    buildArticle({
      url: ogUrl,
      headline: pageTitle,
      description,
      image: ogImage,
      datePublished: publishedTime ?? new Date().toISOString(),
      dateModified: modifiedTime ?? publishedTime,
      tags,
      section,
      wordCount,
      readingMinutes,
    }),
  );
}
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author.name} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow, max-image-preview:large" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large" />
)}
{canonicalURL && <link rel="canonical" href={canonicalURL} />}
<meta property="og:type" content={ogType} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{publishedTime && <meta property="article:author" content={absoluteUrl(SITE.author.profileUrl, SITE.websiteUrl)} />}
{section && <meta property="article:section" content={section} />}
{tags?.map((tag) => <meta property="article:tag" content={humanizeTag(tag)} />)}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale} />
<meta property="og:url" content={ogUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta name="twitter:card" content="summary_large_image" />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
<meta name="twitter:url" content={ogUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": jsonLd })} />
