---
import type { BlogPost } from "@lib/posts";

interface Props {
  newer: BlogPost | null;
  older: BlogPost | null;
}

const { newer, older } = Astro.props;
---

{(newer || older) && (
  <nav class="mt-12 pt-8 rule-line grid grid-cols-1 sm:grid-cols-2 gap-4" aria-label="More notes" data-pagefind-ignore>
    <div class="text-left">
      {newer && (
        <a href={`/${newer.id}/`} class="block group" id="post-nav-newer">
          <span class="note-meta block mb-1">&larr; Newer</span>
          <span class="font-heading font-semibold text-on-surface group-hover:text-tertiary transition-colors">
            {newer.data.title}
          </span>
        </a>
      )}
    </div>
    <div class="text-right">
      {older && (
        <a href={`/${older.id}/`} class="block group" id="post-nav-older">
          <span class="note-meta block mb-1">Older &rarr;</span>
          <span class="font-heading font-semibold text-on-surface group-hover:text-tertiary transition-colors">
            {older.data.title}
          </span>
        </a>
      )}
    </div>
  </nav>
)}
