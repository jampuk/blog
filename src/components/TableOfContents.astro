---
export interface TocItem {
  id: string;
  text: string;
  level: 2 | 3;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <nav class="toc-nav" aria-label="Table of contents" id="toc-nav">
    <p class="note-meta mb-3">// Contents</p>
    <ul class="toc-list">
      {items.map((item) => (
        <li class={item.level === 3 ? "toc-h3" : ""}>
          <a href={`#${item.id}`} class="toc-link" data-toc-id={item.id}>
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
