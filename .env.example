# Jampuk Read (blog) environment variables - copy to .env
# Canonical blog URL. Must match Decap public/admin/config.yml site_url
# and the Cloudflare Pages custom domain.
PUBLIC_SITE_URL=https://read.jampuk.com

# Main marketing site (used for cross-links in header/footer)
PUBLIC_WEBSITE_URL=https://www.jampuk.com

# Google Analytics 4 Measurement ID (leave empty to disable tracking).
# When set, GA4 is offloaded to a Partytown worker and the consent banner
# (Consent Mode v2) is rendered in the footer.
PUBLIC_GA_MEASUREMENT_ID=

